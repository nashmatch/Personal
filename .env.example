# Used only by Prisma CLI tooling (schema diffing/generate) — the app itself
# talks to Cloudflare D1 via the `DB` binding in wrangler.jsonc, not this URL.
DATABASE_URL="file:./dev.db"

# Read via `next dev` locally. Once deployed, set these as Worker vars/secrets
# instead (`wrangler secret put <NAME>`) — see README "Deploying to Cloudflare".

# USDA FoodData Central API key (public, free). Get one at https://fdc.nal.usda.gov/api-key-signup.html
# Falls back to the public DEMO_KEY (rate-limited) if not set.
FDC_API_KEY=DEMO_KEY

# Optional: Google Sheets export/sync (see README for setup)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Optional: base URL the MCP connector (mcp-server/index.ts) calls.
# Defaults to http://localhost:3000 — point it at your deployed Worker URL
# once you've run `npm run deploy`.
FITFUL_API_URL=http://localhost:3000
